{
  "name": "@alveole/root",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "start:ui-kit": "npm run start --workspace=apps/docs -- --clear",
    "doctor": "npm run doctor --workspace=apps/docs",
    "publish:local": "scripts/publish-local",
    "publish:package": "scripts/publish-package",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:update:docker": "scripts/update-visual-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "prettier": "3.9.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3"
  }
}
